# Keep the build context small and free of local state and secrets.
# (vendor/ must NOT be excluded: libpg_query is compiled from
# vendor/libpg_query inside the image.)

# Build outputs and local state
_build/
_build_*/
_opam/
_coverage/
*.install
bisect*.coverage
.merlin
.DS_Store
*.swp
*~

# VCS, CI and editor/agent metadata
.git/
.github/
.claude/
.vscode/
.idea/
ci/

# Local secrets and environment files (never bake these into an image)
.env
.env.*
**/.env
*.pem
*.key

# Language toolchain caches in the non-OCaml SDKs (dune ignores these dirs,
# but they can be large and make every build upload hundreds of MB)
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
clients/java/target/

# Stray objects from building libpg_query in the source tree on the host.
vendor/libpg_query/**/*.o
vendor/libpg_query/*.a
vendor/libpg_query/*.so
vendor/libpg_query/*.dylib

# Not needed to build the binaries.
lab/
docs/
deploy/
bench/
website/
action.yml
