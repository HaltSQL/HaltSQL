(executable
 (name main)
 (public_name haltsql-server)
 (package haltsql-server)
 (libraries haltsql_server haltsql cmdliner lwt lwt.unix)
 (link_flags
  (:include link_flags.sexp)))

; Static linking is opt-in (HALTSQL_STATIC=1), see bin/link_flags.ml.

(rule
 (targets link_flags.sexp)
 (deps
  (env_var HALTSQL_STATIC)
  (env_var HALTSQL_STATIC_GMP))
 (action
  (with-stdout-to
   link_flags.sexp
   (run %{ocaml} %{dep:../link_flags.ml}))))
