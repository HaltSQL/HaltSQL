; Benchmark harness (bench/bench.ml documents the suites). Plain Unix.gettimeofday
; timing; core_bench/bechamel are not dependencies. Run everything with
;   scripts/bench.sh            (builds, runs all suites, writes bench/results/)
; or the fast library suite alone with `make bench` / `dune build @bench --force`.

(executable
 (name bench)
 (libraries haltsql haltsql-proxy.pgwire digestif unix yojson lwt lwt.unix))

(rule
 (alias bench)
 (deps
  (source_tree ../test/corpus)
  (source_tree ../test/fixtures)
  (source_tree corpus))
 (action
  (run %{exe:bench.exe} --root .. --suite library --small)))
