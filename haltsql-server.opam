# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.0.2"
synopsis: "HTTP sidecar for the HaltSQL policy firewall"
description:
  "haltsql-server serves POST /v1/verify over HTTP or built-in TLS/mTLS, authenticates callers with static tokens, OIDC/JWT or client certificates, writes a hash-chained audit log to files, S3 or GCS, loads signed policy bundles, resolves secrets from Vault, AWS or GCP, and exports OpenTelemetry traces and metrics."
maintainer: ["Arnav Dadarya"]
authors: ["Arnav Dadarya"]
license: "MIT"
homepage: "https://github.com/HaltSQL/HaltSQL"
doc: "https://github.com/HaltSQL/HaltSQL/tree/main/docs"
bug-reports: "https://github.com/HaltSQL/HaltSQL/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "haltsql" {= version}
  "cmdliner" {>= "1.1"}
  "yojson" {>= "2.0"}
  "digestif" {>= "1.0"}
  "cohttp" {>= "6.0"}
  "cohttp-lwt" {>= "6.0"}
  "cohttp-lwt-unix" {>= "6.0"}
  "http" {>= "6.0"}
  "conduit-lwt-unix" {>= "7.0"}
  "lwt" {>= "5.6"}
  "uri" {>= "4.0"}
  "zarith" {>= "1.12"}
  "tls" {>= "2.0.4"}
  "tls-lwt" {>= "2.0.4"}
  "x509" {>= "1.2.0"}
  "ptime" {>= "1.0"}
  "eqaf" {>= "0.9"}
  "mirage-crypto-pk" {>= "1.0"}
  "mirage-crypto-ec" {>= "1.0"}
  "mirage-crypto-rng" {>= "1.0"}
  "domain-name" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/HaltSQL/HaltSQL.git"
