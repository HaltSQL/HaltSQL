# /etc/systemd/system/haltsql-server.service
#
# Install:
#   install -m 0755 haltsql-server /usr/local/bin/
#   install -d -m 0755 /etc/haltsql /etc/haltsql/policies
#   install -m 0644 config.yaml /etc/haltsql/          # kind: Config
#   install -m 0600 token-hashes.env /etc/haltsql/     # HALTSQL_*_SHA256=... (optional)
#   systemctl daemon-reload && systemctl enable --now haltsql-server
#   systemctl reload haltsql-server                    # SIGHUP: atomic policy reload
#
# Audit files: point audit.sinks at /var/log/haltsql/audit.jsonl (created
# below via LogsDirectory, owned by the dynamic user).

[Unit]
Description=HaltSQL policy firewall (HTTP sidecar)
Documentation=https://github.com/ardada2468/HaltSQL/tree/main/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/haltsql-server --config /etc/haltsql/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/etc/haltsql/token-hashes.env
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=20s

# Identity and filesystem
DynamicUser=yes
LogsDirectory=haltsql
LogsDirectoryMode=0750
ConfigurationDirectory=haltsql
ReadOnlyPaths=/etc/haltsql
UMask=0027

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
# To serve other hosts, widen IPAddressAllow (e.g. 10.0.0.0/8) and set
# server.listen accordingly; keep TLS termination in front (see README).

LimitNOFILE=65536
TasksMax=512
MemoryMax=512M

[Install]
WantedBy=multi-user.target
