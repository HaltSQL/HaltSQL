# /etc/systemd/system/haltsql-server.service
#
# Install:
#   install -m 0755 haltsql-server /usr/local/bin/
#   install -d -m 0755 /etc/haltsql /etc/haltsql/policies
#   install -m 0644 config.yaml /etc/haltsql/          # kind: Config
#   install -m 0600 token-hashes.env /etc/haltsql/     # HALTSQL_*_SHA256=... (optional)
#   systemctl daemon-reload && systemctl enable --now haltsql-server
#   systemctl reload haltsql-server                    # SIGHUP: atomic policy reload
#
# The same env file may set HALTSQL_VERIFY_THREADS (1-256), the number of
# threads that parse and analyse statements; the default is the CPU count
# (2 to 32). Keep TasksMax (below) well above it.
#
# Audit files: point audit.sinks at /var/log/haltsql/audit.jsonl (created
# below via LogsDirectory, owned by the dynamic user).

[Unit]
Description=HaltSQL policy firewall (HTTP sidecar)
Documentation=https://github.com/HaltSQL/HaltSQL/tree/main/docs
After=network-online.target
Wants=network-online.target
# Restart loops are rate limited rather than spinning forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/local/bin/haltsql-server --config /etc/haltsql/config.yaml
# SIGHUP reloads policies, auth settings and the TLS certificate/key (e.g. from
# a certbot/cert-manager deploy hook: systemctl reload haltsql-server).
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/etc/haltsql/token-hashes.env
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=20s

# Identity and filesystem
DynamicUser=yes
LogsDirectory=haltsql
LogsDirectoryMode=0750
ConfigurationDirectory=haltsql
ReadOnlyPaths=/etc/haltsql
UMask=0027

# Hardening. Check the result with: systemd-analyze security haltsql-server
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
PrivateIPC=yes
# Only the listen port may be bound (systemd >= 249). Keep in sync with
# server.listen (and --health-listen if used); comment out on older systemd.
SocketBindAllow=tcp:8080
SocketBindDeny=any
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
# To serve other hosts, widen IPAddressAllow (e.g. 10.0.0.0/8), set
# server.listen accordingly and enable built-in TLS (server.tls, see
# docs/authentication.md) or keep TLS termination in front (see README).
# OIDC providers (server.auth.oidc) need outbound HTTPS to the IdP's discovery
# and JWKS endpoints: add the IdP's addresses to IPAddressAllow.
# The TLS key must be readable by the service user (e.g. mode 0640, group
# haltsql); the server never logs it.

LimitNOFILE=65536
TasksMax=512
MemoryMax=512M

[Install]
WantedBy=multi-user.target
