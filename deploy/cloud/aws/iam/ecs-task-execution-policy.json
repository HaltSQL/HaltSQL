{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InjectHaltsqlSecretsAtTaskStart",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-west-1:111122223333:secret:prod/haltsql/tokens-??????",
        "arn:aws:secretsmanager:eu-west-1:111122223333:secret:prod/haltsql/tls-??????"
      ]
    },
    {
      "Sid": "DecryptSecretsWithCustomerManagedKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-west-1:111122223333:key/00000000-0000-0000-0000-000000000000",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.eu-west-1.amazonaws.com"
        }
      }
    }
  ]
}
