{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "haltsql chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "runtimeClassName": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowUnauthenticated": {
          "type": "boolean"
        },
        "defaultPolicy": {
          "type": "string"
        },
        "reloadWatch": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        },
        "metrics": {
          "type": "boolean"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sinks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ]
              }
            },
            "logRawSql": {
              "type": "boolean"
            }
          }
        },
        "extraConfig": {
          "type": "object",
          "not": {
            "required": [
              "policies"
            ]
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "policy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "policy"
        ],
        "description": "sha256 is required unless existingTokenSecret supplies the hashes."
      }
    },
    "existingTokenSecret": {
      "type": "string"
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        },
        "clientAuth": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "minVersion": {
          "type": "string",
          "enum": [
            "1.2",
            "1.3"
          ]
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "oidc": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issuer"
        ]
      }
    },
    "mtlsIdentities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "existingPolicyConfigMap": {
      "type": "string"
    },
    "existingPolicyFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "extraPolicies": {
      "description": "Config policies[] entries appended to the rendered policies (path, inline, bundle or bundle_source).",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraConfig": {
      "description": "Config keys deep-merged into the rendered Config document after server.extraConfig. `policies` is refused: use extraPolicies.",
      "type": "object",
      "not": {
        "required": [
          "policies"
        ]
      }
    },
    "cache": {
      "description": "Writable volume for bundle-source caches.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountPath",
        "volume"
      ],
      "properties": {
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "volume": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ]
      }
    },
    "initContainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "extraContainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "internalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object"
        },
        "tcpSocket": {
          "type": "object"
        },
        "grpc": {
          "type": "object"
        },
        "exec": {
          "type": "object"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object"
        },
        "tcpSocket": {
          "type": "object"
        },
        "grpc": {
          "type": "object"
        },
        "exec": {
          "type": "object"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "readinessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object"
        },
        "tcpSocket": {
          "type": "object"
        },
        "grpc": {
          "type": "object"
        },
        "exec": {
          "type": "object"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%?$"
                }
              ]
            }
          ]
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%$"
                }
              ]
            }
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "",
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          ]
        },
        "targetMemoryUtilizationPercentage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          ]
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "description": "Either toggles (allowHTTPS/allowDNS/extraRules) or a list of NetworkPolicyEgressRule objects rendered verbatim.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowHTTPS": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "auto"
                      ]
                    }
                  ]
                },
                "allowDNS": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "auto"
                      ]
                    }
                  ]
                },
                "extraRules": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          ]
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "honorLabels": {
          "type": "boolean"
        },
        "relabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricRelabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tlsConfig": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podAntiAffinityPreset": {
      "type": "string",
      "enum": [
        "",
        "soft",
        "hard"
      ]
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        }
      }
    },
    "podMonitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tls": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tls": {
            "properties": {
              "clientAuth": {
                "enum": [
                  "optional",
                  "required"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "existingTokenSecret": {
            "maxLength": 0
          }
        }
      },
      "then": {
        "properties": {
          "tokens": {
            "items": {
              "required": [
                "name",
                "sha256",
                "policy"
              ]
            }
          }
        }
      }
    }
  ]
}
