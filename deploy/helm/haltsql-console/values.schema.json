{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "haltsql-console chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "objectList": { "type": "array", "items": { "type": "object" } },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "probe": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    },
    "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
    "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "$ref": "#/definitions/digest" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "namespace": { "type": "string" },
        "deployments": { "$ref": "#/definitions/stringList" },
        "statefulsets": { "$ref": "#/definitions/stringList" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "priorityClassName": { "type": "string" },
    "runtimeClassName": { "type": "string" },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "$ref": "#/definitions/port" },
        "devRole": { "type": "string", "enum": ["", "dev", "analyst", "owner", "audit", "admin"] },
        "frontendDir": { "type": "string" },
        "config": {
          "type": "object",
          "not": { "anyOf": [{ "required": ["listen"] }, { "required": ["state_dir"] }] }
        },
        "existingConfigMap": { "type": "string" }
      }
    },
    "existingSecret": { "type": "string" },
    "secretEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "verifierConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": { "type": "string" },
        "policiesConfigMap": { "type": "string" }
      }
    },
    "auditVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": { "type": "string", "pattern": "^/" },
        "volume": { "type": "object", "maxProperties": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "oauth2Proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/definitions/digest" },
            "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
          }
        },
        "port": { "$ref": "#/definitions/port" },
        "existingSecret": { "type": "string" },
        "provider": { "type": "string", "minLength": 1 },
        "oidcIssuerUrl": { "type": "string" },
        "redirectUrl": { "type": "string" },
        "emailDomains": { "$ref": "#/definitions/stringList" },
        "allowedGroups": { "$ref": "#/definitions/stringList" },
        "scope": { "type": "string" },
        "extraArgs": { "$ref": "#/definitions/stringList" },
        "extraVolumeMounts": { "$ref": "#/definitions/objectList" },
        "resources": { "type": "object" }
      }
    },
    "extraArgs": { "$ref": "#/definitions/stringList" },
    "extraEnv": { "$ref": "#/definitions/objectList" },
    "extraEnvFrom": { "$ref": "#/definitions/objectList" },
    "extraVolumes": { "$ref": "#/definitions/objectList" },
    "extraVolumeMounts": { "$ref": "#/definitions/objectList" },
    "initContainers": { "$ref": "#/definitions/objectList" },
    "extraContainers": { "$ref": "#/definitions/objectList" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": { "$ref": "#/definitions/objectList" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] },
        "unhealthyPodEvictionPolicy": { "type": "string", "enum": ["", "IfHealthyBudget", "AlwaysAllow"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "$ref": "#/definitions/objectList" },
        "extraIngress": { "$ref": "#/definitions/objectList" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowDNS": { "type": "boolean" },
            "verifiers": { "$ref": "#/definitions/objectList" },
            "allowHTTPS": { "type": "boolean" },
            "kubernetesAPI": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": { "$ref": "#/definitions/objectList" },
                "port": { "$ref": "#/definitions/port" }
              }
            },
            "extraRules": { "$ref": "#/definitions/objectList" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "$ref": "#/definitions/objectList" },
    "affinity": { "type": "object" }
  }
}
