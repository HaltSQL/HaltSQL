# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "PostgreSQL wire-protocol firewall for LLM-generated SQL"
description:
  "haltsql-proxy sits in front of PostgreSQL, authenticates clients (SCRAM-SHA-256 or TLS client certificates), verifies every statement with HaltSQL and enforces bound tenancy by rewriting Bind parameters."
maintainer: ["Arnav Dadarya"]
authors: ["Arnav Dadarya"]
license: "MIT"
homepage: "https://github.com/HaltSQL/HaltSQL"
doc: "https://github.com/HaltSQL/HaltSQL/tree/main/docs"
bug-reports: "https://github.com/HaltSQL/HaltSQL/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "haltsql" {= version}
  "cmdliner" {>= "1.1"}
  "yojson" {>= "2.0"}
  "digestif" {>= "1.0"}
  "lwt" {>= "5.6"}
  "tls" {>= "2.0.4"}
  "tls-lwt" {>= "2.0.4"}
  "x509" {>= "1.2.0"}
  "ptime" {>= "1.0"}
  "domain-name"
  "ipaddr"
  "mirage-crypto-rng" {>= "1.0"}
  "mirage-crypto-pk" {with-test}
  "mirage-crypto-ec" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/HaltSQL/HaltSQL.git"
