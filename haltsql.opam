# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Policy firewall for LLM-generated PostgreSQL"
description:
  "HaltSQL verifies that an exact SQL string is allowed for a caller under a declarative policy (tables, columns, functions, limits, tenant isolation) using the real PostgreSQL parser. It never rewrites SQL and never connects to the database."
maintainer: ["Arnav Dadarya"]
authors: ["Arnav Dadarya"]
license: "MIT"
tags: ["sql" "postgres" "security" "llm" "policy" "firewall"]
homepage: "https://github.com/HaltSQL/HaltSQL"
doc: "https://github.com/HaltSQL/HaltSQL/tree/main/docs"
bug-reports: "https://github.com/HaltSQL/HaltSQL/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "yojson" {>= "2.0"}
  "yaml" {>= "3.0"}
  "digestif" {>= "1.0"}
  "cmdliner" {>= "1.1"}
  "lwt" {>= "5.6"}
  "cohttp" {>= "6.0"}
  "cohttp-lwt" {>= "6.0"}
  "cohttp-lwt-unix" {>= "6.0"}
  "http" {>= "6.0"}
  "conduit-lwt-unix" {>= "7.0"}
  "uri" {>= "4.0"}
  "base64" {>= "3.5"}
  "ptime" {>= "1.0"}
  "x509" {>= "1.2.0"}
  "tls" {>= "2.0.4"}
  "tls-lwt" {>= "2.0.4"}
  "ca-certs" {>= "1.0"}
  "domain-name" {>= "0.4"}
  "ipaddr" {>= "5.0"}
  "eqaf" {>= "0.9"}
  "mirage-crypto-pk" {>= "1.0"}
  "mirage-crypto-ec" {>= "1.0"}
  "mirage-crypto-rng" {>= "1.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/HaltSQL/HaltSQL.git"
