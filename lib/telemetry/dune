; OpenTelemetry (OTLP/HTTP JSON) exporter for haltsql-server: traces and
; metrics, bounded non-blocking queue, periodic export with retry.

(library
 (name haltsql_telemetry)
 (public_name haltsql-server.telemetry)
 (libraries
