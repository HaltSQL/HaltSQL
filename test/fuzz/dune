; Mutation fuzzer for Haltsql.verify and the YAML/JSON loaders (no AFL here).
; `dune test` runs a short smoke pass; for a long run:
;   HALTSQL_FUZZ_ITERS=1000000 dune test --force test/fuzz
; Crashing inputs are minimized and written to test/fuzz/crashes/.

(executable
 (name fuzz)
 (modules fuzz)
 (libraries haltsql unix yojson))

(rule
 (alias runtest)
 (deps
  (source_tree ../corpus)
  (source_tree ../conformance)
  (source_tree ../fixtures))
 (action
  (run %{exe:fuzz.exe} --root ..)))

; Mutation fuzzer for haltsql-server's caller authentication: Jwt.decode, the
; JWK / JWK Set parser and full token verification. Seeds are the committed
; vectors in test/auth/vectors (valid tokens for all seven algorithms).
;   HALTSQL_FUZZ_ITERS=2000000 dune test --force test/fuzz

(executable
 (name fuzz_jwt)
 (modules fuzz_jwt)
 (libraries
  haltsql
  haltsql-server.auth
  unix
  yojson
  base64
  digestif
  zarith
  mirage-crypto-pk))

(rule
 (alias runtest)
 (deps
  (source_tree ../auth/vectors))
 (action
  (run %{exe:fuzz_jwt.exe} --vectors ../auth/vectors)))
