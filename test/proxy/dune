; haltsql-proxy tests.
;  - test_pgwire_unit: message codecs, SCRAM (RFC 7677 vector), config validation,
;    enforcement decisions and statement-state bookkeeping. No network.
;  - test_proxy_integration: real proxy binary against the lab Postgres
;    (make -C lab up), driven by psycopg 3 (lab/.venv) and a raw protocol client.
;    Skips cleanly when Postgres or the venv is unavailable.

(executable
 (name gencerts)
 (modules gencerts)
 (libraries
  x509
  mirage-crypto-rng
  mirage-crypto-rng.unix
  mirage-crypto-pk
  mirage-crypto-ec
  ptime
  ptime.clock.os))

(test
 (name test_pgwire_unit)
 (package haltsql-proxy)
 (modules test_pgwire_unit)
 (libraries haltsql_pgwire haltsql alcotest yojson lwt lwt.unix unix x509)
 (deps
  (source_tree fixtures)))

(test
 (name test_proxy_integration)
 (package haltsql-proxy)
 (modules test_proxy_integration)
 (libraries haltsql_pgwire haltsql alcotest yojson unix)
 (deps
  pgclient.py
  (source_tree fixtures)
  (file ../../lab/schemas/saas_shared.sql))
 (action
  (setenv
   HALTSQL_PROXY_BIN
   %{dep:../../bin/proxy/main.exe}
   (setenv
    HALTSQL_GENCERTS_BIN
    %{dep:gencerts.exe}
    (run %{test})))))

; Proxy audit (hash-chained sinks, on_error policies) and hot reload.
;  - test_proxy_audit_unit: ProxyConfig audit/reload sections, Paudit file chains.
;  - test_proxy_audit: the real binary against the lab Postgres (FIFO-backed failing
;    sinks, SIGHUP / reload.watch) and an S3 sink writing to a real MinIO container
;    (host port 16002-16003; skipped without Docker or a MinIO image).

(test
 (name test_proxy_audit_unit)
 (package haltsql-proxy)
 (modules test_proxy_audit_unit)
 (libraries
  haltsql_pgwire
  haltsql
  haltsql.cloud
  alcotest
  yojson
  lwt
  lwt.unix)
 (deps
  (source_tree fixtures)))

(test
 (name test_proxy_audit)
 (package haltsql-proxy)
 (modules test_proxy_audit)
 (libraries
  haltsql_pgwire
  haltsql
  haltsql.cloud
  alcotest
  yojson
  unix
  lwt
  lwt.unix
  uri
  cohttp)
 (deps
  pgclient.py
  (source_tree fixtures)
  (file ../../lab/schemas/saas_shared.sql))
 (action
  (setenv
   HALTSQL_PROXY_BIN
   %{dep:../../bin/proxy/main.exe}
   (setenv
    HALTSQL_AUDIT_CLI
    %{dep:../audit/audit_cli.exe}
    (run %{test})))))
